[DEFAULT]
key-format = "{doc[author_list][0][family]} {doc[year]} {doc[title]:.15}"

[papers]
dir = ~/Documents/library/papers

[books]
dir = ~/Documents/library/books

[settings]
default-library = papers
use-git = True

# tools
opentool = open
file-browser = open

# naming
ref-word-separator = -
ref-format = %(key-format)s
add-folder-name = %(key-format)s
add-file-name = %(key-format)s
