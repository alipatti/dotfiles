# set env variables
EDITOR="nvim"
TERMINAL="kitty"

XDG_CONFIG_HOME="$HOME/.config"
XDG_DATA_HOME="$HOME/.local/share"
XDG_CACHE_HOME="$HOME/.cache"
XDG_STATE_HOME="$HOME/.local/state"

N_PREFIX="$HOME/.n"

BAT_THEME="Coldark-Dark"

# https://docs.brew.sh/Manpage#environment
HOMEBREW_AUTO_UPDATE_SECS=1209600
HOMEBREW_NO_ENV_HINTS=1

FZF_DEFAULT_OPTS='--border --height 40% --layout="reverse" --info="right" --padding="1" --margin="1" --prompt="❯ " --marker="✔ " --pointer=" " --color=16 --color=bg+:-1'

CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1

POLARS_ENGINE_AFFINITY="streaming"
