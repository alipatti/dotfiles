#!/usr/bin/env bash

# usage: ./setup [host]  (e.g. ./setup macbook; defaults to the hostname)
#
# anything that isn't macos or nixos is a cluster, configured by its entry in
# home/cluster.nix. the default name there is the hostname without
# trailing digits (adroit5 -> adroit)

set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
host=${1:-$(hostname -s)}

if [ "$(uname)" = Darwin ]; then
    if ! xcode-select -p >/dev/null 2>&1; then
        xcode-select --install
        echo "rerun ./setup once the command line tools finish installing"
        exit 0
    fi

    if ! command -v nix >/dev/null; then
        curl -fsSL https://install.determinate.systems/nix | sh -s -- install --no-confirm
        . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
    fi

    if [ ! -x /opt/homebrew/bin/brew ]; then
        NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    if command -v darwin-rebuild >/dev/null; then
        sudo darwin-rebuild switch --flake ".#$host"
    else
        sudo nix run --inputs-from . nix-darwin#darwin-rebuild -- switch --flake ".#$host"
    fi

elif [ -f /etc/NIXOS ]; then
    sudo nixos-rebuild switch --flake ".#$host"
    # switch only restarts the home-manager unit when the generation changes,
    # so rerun it to restore links that went missing since the last change
    sudo systemctl restart "home-manager-$USER.service"

else
    cluster=${1:-$(hostname -s | sed 's/[0-9]*$//')}
    chroot=$HOME/.local/bin/nix-user-chroot
    store=$HOME/.cache/nix

    if [ ! -x "$chroot" ]; then
        mkdir -p "$(dirname "$chroot")"
        curl -fsSL -o "$chroot" https://github.com/nix-community/nix-user-chroot/releases/download/2.1.1/nix-user-chroot-bin-2.1.1-x86_64-unknown-linux-musl
        chmod +x "$chroot"
    fi

    # already inside the chroot when rerun from the fish it starts
    in_chroot() {
        if [ -n "${NIX_CHROOT:-}" ]; then bash -c "$1"; else "$chroot" "$store" bash -c "$1"; fi
    }

    # no ~/.nix-profile means no install or an interrupted one, so start over
    if [ ! -L ~/.nix-profile ]; then
        if [ -d "$store" ]; then chmod -R u+w "$store" && rm -rf "$store"; fi
        mkdir -p "$store"
        in_chroot 'curl -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon --no-modify-profile'
    fi

    # build and run the activation script directly. the home-manager cli is
    # built against its own pinned nixpkgs, a second ~200 MiB download onto nfs
    in_chroot '. ~/.nix-profile/etc/profile.d/nix.sh &&
        export NIX_CONFIG="experimental-features = nix-command flakes" &&
        export HOME_MANAGER_BACKUP_EXT=bak &&
        "$(nix build --no-link --print-out-paths .#homeConfigurations.'"$cluster"'.activationPackage)"/activate'

    # login shells enter the chroot and start fish. this has to be a real file:
    # anything home-manager writes is a symlink into /nix, which doesn't exist
    # until the chroot is entered
    if ! grep -q NIX_CHROOT ~/.bash_profile 2>/dev/null; then
        cat >>~/.bash_profile <<EOF

# enter the nix chroot (see ~/.dotfiles/setup). interactive logins only, so
# scp and batch jobs keep the plain system shell
if [ -z "\$NIX_CHROOT" ] && [[ \$- == *i* ]]; then
    export NIX_CHROOT=1
    exec $chroot $store ~/.nix-profile/bin/fish -l
fi
EOF
    fi
fi
